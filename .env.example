# ---------------------------------------------------------------------------
# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# NEVER commit the real .env.local file.
# ---------------------------------------------------------------------------

# Telegram
BOT_TOKEN=123456:ABC-DEF_your_botfather_token
# Optional but recommended: the secret_token you pass to setWebhook.
TELEGRAM_WEBHOOK_SECRET=some-long-random-string

# --- Firebase credentials: pick ONE of the two styles below ---------------

# OPTION A — single combined value (raw JSON or base64).
# Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. Paste the WHOLE file as one line.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# OPTION B — three separate values (easier to paste correctly).
# FIREBASE_PROJECT_ID=pricetracker-2c303
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pricetracker-2c303.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n

# Affiliate tags
AMAZON_AFFILIATE_TAG=aipricealert-21
# Flipkart affiliate is intentionally NOT set yet (application pending) —
# Flipkart links are posted untagged until it is approved.
# FLIPKART_AFFILIATE_ID=adminnxtify

# --- Hybrid affiliate conversion ------------------------------------------
# Amazon uses your direct Associates tag (above). EVERY other store is routed
# through an external converter (Affiliaters / EarnKaro) that rebuilds the link
# with your own network IDs. Set these two to enable that; leave them unset and
# the bot falls back to plain cleaned links (nothing breaks).
# AFFILIATERS_CONVERTER_URL=https://app.affiliaters.in/api/convert
# AFFILIATERS_TOKEN=your_affiliaters_token

# Public base URL of this deployment (used for the "Price History" button + logo)
WEB_APP_URL=https://your-project.vercel.app

# Optional: override the /start welcome image. By default the bot uses the
# bundled public/welcome.jpg served from this deployment (WEB_APP_URL).
# BOT_LOGO_URL=https://example.com/my-welcome.jpg

# Telegram channel the "Today's Deals" button opens
# (default: https://t.me/Ai_PriceAlert)
# TELEGRAM_CHANNEL_URL=https://t.me/Ai_PriceAlert

# Set to true to hide the "no affiliate tag configured" note in bot replies
# HIDE_TAG_WARNING=true

# --- Deals auto-poster (api/deals.js) -------------------------------------

# Channel the deals are posted to
DEALS_CHANNEL_ID=-1004386388150
# Bitly v4 access token (bit.ly -> Settings -> API). Regenerate if leaked.
BITLY_ACCESS_TOKEN=your_bitly_access_token
# Only post deals at least this % off
DEALS_MIN_DISCOUNT=50
# Max posts per run
DEALS_MAX_PER_RUN=5
# Don't repost the same product within this many days
DEALS_REPOST_DAYS=30
# Listing pages to scrape (comma-separated). Defaults to a few Flipkart searches.
# DEALS_SOURCE_URLS=https://www.flipkart.com/search?q=top%20offers&sort=popularity

# Cron
CRON_SECRET=some-long-random-string
CRON_BATCH_SIZE=20
PRICE_DROP_THRESHOLD_PERCENT=1
