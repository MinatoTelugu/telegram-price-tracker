# ---------------------------------------------------------------------------
# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# NEVER commit the real .env.local file.
# ---------------------------------------------------------------------------

# Telegram
BOT_TOKEN=123456:ABC-DEF_your_botfather_token
# Optional but recommended: the secret_token you pass to setWebhook.
TELEGRAM_WEBHOOK_SECRET=some-long-random-string

# --- Firebase credentials: pick ONE of the two styles below ---------------

# OPTION A — single combined value (raw JSON or base64).
# Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. Paste the WHOLE file as one line.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# OPTION B — three separate values (easier to paste correctly).
# FIREBASE_PROJECT_ID=pricetracker-2c303
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pricetracker-2c303.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n

# Affiliate tags
AMAZON_AFFILIATE_TAG=aipricealert-21
# Flipkart affiliate is intentionally NOT set yet (application pending) —
# Flipkart links are posted untagged until it is approved.
# FLIPKART_AFFILIATE_ID=adminnxtify

# --- Hybrid affiliate conversion ------------------------------------------
# Amazon uses your direct Associates tag (above). EVERY other store is routed
# through the Affiliaters / EarnKaro converter, which rebuilds the link with
# your own network IDs. Set the token to enable it; leave it unset and the bot
# falls back to plain cleaned links (nothing breaks).
#
# The URL below is the default and can be omitted.
AFFILIATERS_CONVERTER_URL=https://ekaro-api.affiliaters.in/api/converter/public
# Your Affiliaters API key (from the API setup page). Keep it secret.
AFFILIATERS_TOKEN=

# --- Hosted Amazon product API (LAST resort, small free tier) --------------
# A hosted API (Omkar Cloud's Amazon Scraper on RapidAPI) — fetches from the
# vendor's servers, so Amazon's block on our IP does not apply. Free tier is
# 1,000 calls/month (~33/day), so it is only reached when the page, the metadata
# service, the reader and the search API all come back empty.
# NOTE: the open-source version of that project is a scraper you run YOURSELF —
# it would leave from this same IP and be blocked, and it works by impersonating
# a browser's TLS fingerprint. We use the hosted API instead.
# RAPIDAPI_KEY=your_rapidapi_key
# AMAZON_API_HOST=best-amazon-scraper-free-1000-calls.p.rapidapi.com
# AMAZON_API_COUNTRY=IN
# AMAZON_API_TIMEOUT_MS=20000
#
# NOTE: that RapidAPI listing IS Omkar Cloud's scraper (rapidapi.com/OmkarCloud),
# so with RAPIDAPI_KEY set you are already using Omkar — on the larger free tier.
#
# Omkar Cloud also sell the SAME data direct, with a smaller allowance. Optional:

# --- Reader service: read a page Amazon refuses us -------------------------
# Amazon blocks this host, so a bare /dp/ASIN link can end up with no name at
# all. A reader service fetches the page from ITS servers and returns the text,
# which gives us the product name AND a price. Keyless for ordinary use.
# READER_API_URL=https://r.jina.ai/
# READER_TIMEOUT_MS=8000

# --- Optional SEARCH fallback for product names ----------------------------
# When the store refuses our host and the page gives no name, ask a licensed
# search API for Amazon results and read the product name from them. Snippets
# only, so token use is tiny. Free plan: https://langsearch.com
# LANGSEARCH_API_KEY=your_langsearch_key
# LANGSEARCH_API_URL=https://api.langsearch.com/v1/web-search
# LANGSEARCH_TIMEOUT_MS=6000

# --- Amazon Product Advertising API (the ONLY reliable Amazon fix) ---------
# Amazon refuses ordinary page requests from a datacenter IP, so scraping
# amazon.in returns a robot-check page. PA-API is authenticated and made for
# servers, so it is not blocked — it returns title, price, MRP and image.
# Granted by Amazon to Associates with qualifying sales.
# PAAPI_ACCESS_KEY=your_access_key
# PAAPI_SECRET_KEY=your_secret
# PAAPI_PARTNER_TAG=offerszones03-21
# PAAPI_HOST=webservices.amazon.in
# PAAPI_REGION=eu-west-1
# PAAPI_MARKETPLACE=www.amazon.in

# --- Last-resort product metadata (Amazon blocks this host) ----------------
# When our own scrape cannot read a product page (Amazon refuses datacenter
# IPs), the name/image are recovered from a public link-preview service that
# fetches the page from ITS servers. Only used when the scrape found no usable
# title, and only in the background — it never slows a reply.
# METADATA_API_URL=https://api.microlink.io/
# METADATA_TIMEOUT_MS=4000

# --- Cuelinks v3 (non-Amazon stores) ---------------------------------------
# Flipkart, Myntra, AJIO, Nykaa and every other Cuelinks merchant are converted
# with this key. AMAZON IS NOT AFFECTED — it always keeps your direct
# Associates tag above. Leave the key unset to disable it (nothing breaks).
# Get a key with the `write:links` scope from your Cuelinks publisher panel.
# CUELINKS_API_KEY=your_cuelinks_api_key
# CUELINKS_API_URL=https://developers.cuelinks.com/pub_api/v3
# CUELINKS_SHORTEN=true            (default) -> clean clnk.in links
# CUELINKS_CHANNEL_ID=
# CUELINKS_TIMEOUT_MS=2500

# /broadcast: gap between dispatches (ms). 50 keeps clear of Telegram 429s.
# BROADCAST_DELAY_MS=50

# --- REMOVED: the HuggingFace fallback --------------------------------------
# HF_TOKEN, HF_MODEL and HF_API_URL used to enable an optional AI title/price
# fallback. It has been removed from the code, so those variables do nothing —
# delete them from your host if you set them.
#
# Why removed: it called api-inference.huggingface.co, which no longer resolves
# at all (the logs showed "getaddrinfo ENOTFOUND"). HuggingFace retired that host,
# so whenever HF_TOKEN was set the bot made a network call that could never
# succeed — wasted time on every weak title and every missing price.

# Public base URL of this deployment (used for the "Price History" button + logo)
WEB_APP_URL=https://your-project.vercel.app

# --- New-user log -------------------------------------------------------------
# Every first-time user of the bot is announced here. Leave it unset to switch the
# log off. This is a record only — there is NO channel-join lock or force-subscribe
# anywhere, so a new user can use the bot immediately.
# LOG_CHANNEL=-1001234567890

# --- Admin --------------------------------------------------------------------
# Who may run /diag, /broadcast and /stats. If unset, the first person to run
# /diag becomes the admin and is remembered. /stats is SILENT for everyone else.
# ADMIN_USER_ID=123456789

# Optional: override the /start welcome image. By default the bot uses the
# bundled public/welcome.jpg served from this deployment (WEB_APP_URL).
# BOT_LOGO_URL=https://example.com/my-welcome.jpg

# Telegram channel the "Today's Deals" button opens
# (default: https://t.me/Ai_PriceAlert)
# TELEGRAM_CHANNEL_URL=https://t.me/Ai_PriceAlert

# Set to true to hide the "no affiliate tag configured" note in bot replies
# HIDE_TAG_WARNING=true

# --- Deals auto-poster (api/deals.js) -------------------------------------

# Channel the deals are posted to
CHANNEL_ID=-1004386388150
# Bitly v4 access token (bit.ly -> Settings -> API). Regenerate if leaked.
# Deals threshold, in percent. Default 20 — anything at or above is posted.
# ?minDiscount=NN on the request overrides it for a single run.
MIN_DISCOUNT=20
# Max posts per run
DEALS_MAX_PER_RUN=5
# Don't repost the same product within this many days
DEALS_REPOST_DAYS=30
# Listing pages to scrape (comma-separated). Defaults to a few Flipkart searches.
# DEALS_SOURCE_URLS=https://www.flipkart.com/search?q=top%20offers&sort=popularity

# --- Short-link expansion budgets (seconds matter here) ----------------------
# A short link is expanded by trying several routes in order. Each is bounded,
# but they run one after another, so an unbounded SUM is an unbounded wait — a
# Flipkart link once held the bot for nearly two minutes.
#
#   SHORTLINK_DEADLINE_MS   hard ceiling on the WHOLE expansion (default 6000)
#   SHORTLINK_TIMEOUT_MS    the redirect-following route (default 5000)
#   SHORTLINK_HOP_BUDGET_MS total for the manual hop loop (default 4000)
#
# Past the deadline the link fails fast with "I could not open that short link"
# rather than stalling. A quick honest failure beats a slow one.
# SHORTLINK_DEADLINE_MS=6000

# The lowest price any real listing can carry, in rupees. Anything below this is
# rejected as a bad read (the scraper once reported Rs 4 for a Rs 22,999 phone).
# Default 20.
# MIN_PLAUSIBLE_PRICE=20

# Cron
CRON_SECRET=some-long-random-string
CRON_BATCH_SIZE=20

# How often to check prices. THIS IS THE BIGGEST LEVER ON THE FREE TIER.
#
# Each run reads CRON_SCAN_LIMIT documents to choose CRON_BATCH_SIZE products to
# check, then writes a history reading per product. At the default 6-hourly that
# is comfortably inside a 20k/day quota. Hourly is roughly four times the reads
# and is what empties the quota before lunchtime.
#
# Leave this unset to use the built-in default of 6-hourly, or set it to at most
# '0 */4 * * *'. Do NOT set '0 * * * *' (hourly) on the free tier.
#
# You do not have to get this right any more: a schedule more frequent than
# PRICE_CRON_MIN_HOURS is CLAMPED to it at startup, with a loud log line. Hourly
# becomes 4-hourly whether you meant it or not.
# PRICE_CRON=0 */4 * * *

# The floor for the schedule above, in hours. Default 4. Set to 1 to allow hourly
# deliberately (the free tier will not enjoy it).
# PRICE_CRON_MIN_HOURS=4

# When Firestore answers RESOURCE_EXHAUSTED, the client RETRIES it with backoff.
# Retrying a spent quota is pure waste — it refills at midnight Pacific, not
# because we asked twice — so the first quota error opens a breaker for this many
# minutes. While it is open /list serves its last saved copy and the cron refuses
# to start, instead of hammering a database that is already refusing everything.
# Set to 0 to disable the breaker.
# QUOTA_BREAK_MINUTES=10

# Documents read per run to pick which products to check. Defaults to 4x
# CRON_BATCH_SIZE (80 at the default batch of 20). Raise only if a run is
# starving because too many products are stopped.
# CRON_SCAN_LIMIT=80

# How long a user's /list reply is reused without reading the database, in
# minutes. /list also falls back to the last saved copy when the database
# refuses the request, so it keeps working even when the quota is spent.
# LIST_CACHE_MINUTES=15

PRICE_DROP_THRESHOLD_PERCENT=1

# --- One-off price-history cleanup (lib/cleanHistory.js) ----------------------
# The cleanup removes readings that fail a sanity check: a price far below the
# product's high readings that does not LAST (a real drop stays down). These
# tune it, and the defaults suit most cases.
#   CLEAN_LOW_RATIO      a reading must be under this fraction of the product's
#                        high readings to be considered (default 0.6 = 60%)
#   CLEAN_RECOVER_RATIO  how far the price must BOUNCE BACK above the low reading
#                        to count as a misread. A deal that ends rises a little
#                        (13999 -> 19999 is 1.43x); a misread snaps back hugely
#                        (10490 -> 19999 is 1.91x). Default 1.5.
#   CLEAN_MAX_RUN        a low price holding for MORE than this many consecutive
#                        readings is a real drop and is kept. Generous by design:
#                        a bad scrape repeats the same wrong figure every check,
#                        so its run is long too. Default 12 (6 hours at 30 min).
#   CLEAN_MIN_POINTS     leave a product alone below this many readings (default 5)
#   CLEAN_MAX_FRACTION   refuse if more than this fraction would go (default 0.5)
CLEAN_LOW_RATIO=0.6
CLEAN_RECOVER_RATIO=1.5
CLEAN_MAX_RUN=12
CLEAN_MIN_POINTS=5
CLEAN_MAX_FRACTION=0.5

# The repair also runs BY ITSELF, once a day, inside the price-check cron — so a
# polluted history is fixed without anyone remembering a command. This is the hour
# (IST) it runs at; set -1 to switch the automatic pass off.
CLEAN_HOUR=3

# --- Self-correction (runs automatically after every trusted price reading) ---
# When a price is validated as correct (a labelled price, one anchored on the
# M.R.P., or the hosted API's buybox), that product's history is checked against
# it and against the MRP, and what they contradict is removed. No manual cleanup.
#   SELF_CLEAN_BAND_PERCENT      how far a reading may sit from the trusted price
#                                before it becomes a candidate (default 30)
#   SELF_CLEAN_CERTAIN_PERCENT   beyond this it is a different product's figure
#                                outright, removed however long it sat (55)
#   SELF_CLEAN_MIN_POINTS        leave a history this short alone (5)
#   SELF_CLEAN_MAX_FRACTION      never remove more than this share in one pass
#                                (0.5). Impossible readings are exempt.
#   SELF_CLEAN_MAX_RUN           a run longer than this is a real price (20)
SELF_CLEAN_BAND_PERCENT=30
SELF_CLEAN_CERTAIN_PERCENT=55
SELF_CLEAN_MIN_POINTS=5
SELF_CLEAN_MAX_FRACTION=0.5
SELF_CLEAN_MAX_RUN=20


# --- Alert cooldown ---------------------------------------------------------
# An IDENTICAL alert (same event, same price) is suppressed for this many
# minutes. A genuinely different alert is never held back. Default 180.
# The screenshots showed the same "BACK IN STOCK ALERT" at 11:57 and again at
# 11:58; this is what stops that.
ALERT_COOLDOWN_MINUTES=180


# --- Firestore write throttling ---------------------------------------------
# upsertUser runs on EVERY message. It used to do a read + a write each time,
# which exhausted the free-tier quota:
#   user upsert failed: 8 RESOURCE_EXHAUSTED: Quota exceeded.
# A user touched within this many minutes now costs NOTHING — no read, no write.
# Default 360 (6 hours).
USER_TOUCH_MINUTES=360

# --- Deal repost window ------------------------------------------------------
# Nothing is posted twice inside this window. DEALS_REPOST_HOURS is the finer
# knob and wins when set (e.g. 24 to skip anything posted in the last day);
# DEALS_REPOST_DAYS is the coarser fallback.
DEALS_REPOST_HOURS=24
DEALS_REPOST_DAYS=30

# --- Firestore-heavy pass throttling ----------------------------------------
# These read whole history collections, so they are the difference between a
# comfortable quota and none. They used to run on EVERY price check.
#   SELF_CLEAN_MIN_HOURS  min hours between self-correction passes per product (12)
#   PRUNE_MIN_HOURS       min hours between history prunes per product (24)
SELF_CLEAN_MIN_HOURS=12
PRUNE_MIN_HOURS=24

# --- History repair pass caps ------------------------------------------------
# The daily repair reads every product's history. Uncapped, one pass pulled tens
# of thousands of documents and exhausted the free-tier day in a single burst —
# which is why /list answered "quota exceeded" for hours.
#   CLEAN_MAX_PRODUCTS   products swept per pass (100)
#   CLEAN_MAX_READINGS   readings read per product (300)
CLEAN_MAX_PRODUCTS=100
CLEAN_MAX_READINGS=300
