{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/deals",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/deals.js": {
      "maxDuration": 60
    }
  }
}